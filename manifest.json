{
  "manifest_version": 3,
  "name": "Calculadora de Gastos Shopee",
  "version": "1.0",
  "description": "Calcula o total gasto nas suas compras da Shopee.",
  "permissions": ["activeTab", "scripting"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "host_permissions": [
    "https://shopee.com.br/*"
  ]
}